{
 "info": {
  "name": "CV Assistant - API v2 (Auth + MinIO + Cache)",
  "description": "Functional tests for CV Assistant v2: JWT auth on every CV endpoint, verification-code password reset (no enumeration), JSON + MinIO presigned URL responses, application cache, per-user ownership (403).\n\n  newman run postman/CV-Assistant.postman_collection.json -e postman/CV-Assistant.postman_environment.json --working-dir postman --timeout-request 240000\n\nNeeds a live server with NVIDIA_API_KEY + database + MinIO, and PASSWORD_RESET_DEV_MODE=true (so the reset code comes back in the body).",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "event": [
  {
   "listen": "prerequest",
   "script": {
    "exec": [
     "if (!pm.collectionVariables.get('run_id')) {",
     "  const rid = Date.now().toString();",
     "  pm.collectionVariables.set('run_id', rid);",
     "  pm.collectionVariables.set('email_a', 'alice-' + rid + '@demo.com');",
     "  pm.collectionVariables.set('email_b', 'bob-' + rid + '@demo.com');",
     "}",
     "if (!pm.collectionVariables.get('language')) pm.collectionVariables.set('language', 'fr');"
    ]
   }
  }
 ],
 "variable": [
  {
   "key": "run_id",
   "value": ""
  },
  {
   "key": "email_a",
   "value": ""
  },
  {
   "key": "email_b",
   "value": ""
  },
  {
   "key": "token_a",
   "value": ""
  },
  {
   "key": "token_b",
   "value": ""
  },
  {
   "key": "reset_code",
   "value": ""
  },
  {
   "key": "forgot_message",
   "value": ""
  },
  {
   "key": "cv_id",
   "value": ""
  },
  {
   "key": "letter_id",
   "value": ""
  },
  {
   "key": "stats_before",
   "value": "0"
  },
  {
   "key": "language",
   "value": "fr"
  }
 ],
 "item": [
  {
   "name": "Health check",
   "request": {
    "method": "GET",
    "url": "{{base_url}}/api/health",
    "header": []
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "exec": [
       "pm.test('200 OK', () => pm.response.to.have.status(200));",
       "const b = pm.response.json();",
       "pm.test('status ok', () => pm.expect(b.status).to.eql('ok'));",
       "pm.test('service = cv-generator', () => pm.expect(b.service).to.eql('cv-generator'));",
       "pm.test('version 2.x', () => pm.expect(b.version).to.match(/^2\\./));",
       "pm.test('reports gemini_configured', () => pm.expect(b).to.have.property('gemini_configured'));"
      ]
     }
    }
   ]
  },
  {
   "name": "Stats - baseline",
   "request": {
    "method": "GET",
    "url": "{{base_url}}/api/stats",
    "header": []
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "exec": [
       "pm.test('200 OK', () => pm.response.to.have.status(200));",
       "const b = pm.response.json();",
       "['total_calls','cache_hits','total_input_chars','total_output_chars','cache_size'].forEach(k =>",
       "  pm.test('has ' + k, () => pm.expect(b[k]).to.be.a('number')));"
      ]
     }
    }
   ]
  },
  {
   "name": "Auth - Signup user A",
   "request": {
    "method": "POST",
    "url": "{{base_url}}/api/auth/signup",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "body": {
     "mode": "raw",
     "raw": "{\n  \"email\": \"{{email_a}}\",\n  \"password\": \"Str0ngPass1\"\n}"
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "exec": [
       "pm.test('201 Created', () => pm.response.to.have.status(201));",
       "const b = pm.response.json();",
       "pm.test('has access_token', () => pm.expect(b.access_token).to.be.a('string'));",
       "pm.test('token_type bearer', () => pm.expect(b.token_type).to.eql('bearer'));",
       "pm.test('user email echoed', () => pm.expect(b.user.email).to.eql(pm.collectionVariables.get('email_a')));",
       "pm.test('no password_hash leaked', () => pm.expect(pm.response.text()).to.not.include('password_hash'));",
       "pm.collectionVariables.set('token_a', b.access_token);"
      ]
     }
    }
   ]
  },
