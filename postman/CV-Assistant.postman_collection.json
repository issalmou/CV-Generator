  {
   "name": "Generate CV - FR (Bearer, JSON + MinIO URL)",
   "request": {
    "method": "POST",
    "url": "{{base_url}}/api/generate-cv",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     },
     {
      "key": "Authorization",
      "value": "Bearer {{token_a}}"
     }
    ],
    "body": {
     "mode": "raw",
     "raw": "{\n  \"language\": \"fr\",\n  \"job_description\": \"Nous recrutons un ingenieur backend Python, FastAPI, PostgreSQL, Kubernetes.\",\n  \"cv_profile\": {\n    \"name\": \"Alice Martin\",\n    \"email\": \"alice@demo.com\",\n    \"phone\": \"+212 600 112233\",\n    \"linkedin\": \"linkedin.com/in/alicemartin\",\n    \"professional_summary\": \"Backend engineer focused on data platforms and API design.\",\n    \"education\": [\n      {\n        \"institution\": \"INSEA\",\n        \"degree\": \"Master\",\n        \"field\": \"Data Science\",\n        \"start_date\": \"2020\",\n        \"end_date\": \"2022\"\n      }\n    ],\n    \"experience\": [\n      {\n        \"company\": \"Acme Corp\",\n        \"position\": \"Software Engineer\",\n        \"period\": \"Jan 2021 - Present\",\n        \"achievements\": [\n          \"Shipped the billing service handling 2M requests/day\"\n        ],\n        \"technologies\": [\n          \"Python\",\n          \"PostgreSQL\",\n          \"FastAPI\"\n        ]\n      }\n    ],\n    \"projects\": [],\n    \"skills\": [\n      {\n        \"category\": \"Languages\",\n        \"skills\": [\n          \"Python\",\n          \"SQL\"\n        ]\n      }\n    ],\n    \"languages\": [\n      {\n        \"language\": \"English\",\n        \"level\": \"Fluent\"\n      }\n    ],\n    \"certifications\": []\n  }\n}"
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "exec": [
       "pm.test('200 OK', () => pm.response.to.have.status(200));",
       "const b = pm.response.json();",
       "pm.test('status success', () => pm.expect(b.status).to.eql('success'));",
       "pm.test('has generated_cv_id', () => pm.expect(b.generated_cv_id).to.be.a('string'));",
       "pm.test('language fr', () => pm.expect(b.language).to.eql('fr'));",
       "pm.test('ats_score is a number', () => pm.expect(b.ats_score).to.be.a('number'));",
       "pm.test('filename ends .pdf', () => pm.expect(b.filename).to.match(/\\.pdf$/));",
       "pm.test('download_url is a presigned URL', () => pm.expect(b.download_url).to.match(/X-Amz-Signature=/));",
       "pm.test('expires_in > 0', () => pm.expect(b.expires_in).to.be.above(0));",
       "pm.test('response is JSON, not a PDF stream', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
       "pm.collectionVariables.set('cv_id', b.generated_cv_id);",
       "// snapshot the gemini call counter AFTER the first (cache-priming) generation",
       "pm.sendRequest(pm.environment.get('base_url') + '/api/stats', (e, r) => {",
       "  if (!e) pm.collectionVariables.set('calls_after_first_gen', r.json().total_calls);",
       "});"
      ]
     }
    }
   ]
  },
