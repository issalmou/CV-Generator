  {
   "name": "Extract CV - with language (Bearer)",
   "request": {
    "method": "POST",
    "url": "{{base_url}}/api/extract-cv",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{token_a}}"
     }
    ],
    "body": {
     "mode": "formdata",
     "formdata": [
      {
       "key": "file",
       "type": "file",
       "src": "sample_resume.txt"
      },
      {
       "key": "language",
       "value": "{{language}}",
       "type": "text"
      }
     ]
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "exec": [
       "pm.test('200 OK', () => pm.response.to.have.status(200));",
       "const b = pm.response.json();",
       "pm.test('status success', () => pm.expect(b.status).to.eql('success'));",
       "pm.test('name extracted', () => pm.expect(b.cv_profile.name).to.match(/John/i));",
       "pm.test('email extracted', () => pm.expect(b.cv_profile.email).to.eql('john.doe@example.com'));",
       "pm.test('confidence has 5 keys', () => pm.expect(Object.keys(b.confidence_scores).sort()).to.eql(['contact','education','experience','projects','skills']));",
       "pm.test('skills flat list of strings', () => (b.cv_profile.skills||[]).forEach(s => pm.expect(s).to.be.a('string')));"
      ]
     }
    }
   ]
  },
