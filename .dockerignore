# Secrets — the key is injected at runtime via --env-file / compose env_file,
# never baked into the image.
.env
.env.*
!.env.example

# VCS / IDE
.git
.gitignore
.idea
.vscode

# Python caches / build artefacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtualenvs
.venv/
venv/
env/

# Tests, docs and tooling not needed at runtime
tests/
postman/
README.md
PROJECT_STRUCTURE.md
pytest.ini
requirements-dev.txt

# Local output
generated_cvs/
*.pdf
