# ---------------------------------------------------------------------------
# CV Assistant - environment variables
# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- LLM backend (ONE implementation, N presets — all OpenAI-compatible) --
# There is a single provider class; "provider" below just selects a
# (base_url, api_key, model) preset. No per-provider code path.
# Active provider: nvidia | openai | gemini | mistral | groq | openai_compatible | custom
LLM_PROVIDER=nvidia
# Generic knobs — apply to every provider and are the fallback for the
# per-provider blocks below.
# LLM_API_KEY=
# LLM_BASE_URL=                     # empty -> the active provider's own default base URL
# LLM_MODEL=                       # empty -> built-in NVIDIA fallback chain
# LLM_MODELS_FALLBACK=             # CSV of extra model ids tried in order
# LLM_TEMPERATURE=0.3
# LLM_MAX_OUTPUT_TOKENS=4096
# LLM_REQUEST_TIMEOUT=45.0
# LLM_MAX_CALLS_PER_MINUTE=30
#
# per-provider blocks — the active provider's own vars win over the generics.
# https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NVIDIA_MODEL=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=
# OPENAI_COMPATIBLE_BASE_URL=https://your-endpoint/v1
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_MODEL=
# CUSTOM_LLM_BASE_URL=
#
# --- LLM routing (v2.9 Phase 2b) ------------------------------------------
# call_gemini routes each request_type through config.DEFAULT_LLM_ROUTING.
# Default chains (2026-09): Groq openai/gpt-oss-120b primary, Gemini
# gemini-3.5-flash-lite fallback. NVIDIA is NEVER an automatic fallback
# (unstable baseline); Mistral is disabled (free-tier key 429s).
# LLM_ROUTING_ENABLED=true            # false -> single LLM_PROVIDER (legacy / rollback)
# LLM_DISABLED_PROVIDERS=mistral      # CSV; never auto-used, still buildable on demand
# LLM_ROUTING_OVERRIDES=              # JSON, merged over the defaults, e.g.
#   {"cover_letter":{"chain":[["gemini","gemini-3.5-flash"],["groq","openai/gpt-oss-120b"]]}}
# LLM_ROUTING_TIMEOUT_OVERRIDES=      # JSON {request_type: seconds}
#
# --- LLM circuit breaker (per process/worker, in-memory) -----------------
# LLM_CIRCUIT_ENABLED=true
# LLM_CIRCUIT_FAIL_THRESHOLD=3        # consecutive failures -> breaker opens
# LLM_CIRCUIT_COOLDOWN_SECONDS=60     # then half-open (one probe)
#
# --- Provider capacity note (PRODUCTION) ---------------------------------
# The Groq FREE tier caps tokens/minute (~8000 TPM for gpt-oss-120b). Under
# load call_gemini fails over Groq -> Gemini; if BOTH are rate-limited in the
# same window a request fails fast (~10 s) instead of hanging. For production
# use a paid tier: create the Groq key on Dev Tier (console.groq.com billing)
# and/or a paid Gemini project. Routing + fallback + circuit breaker stay
# active with a paid provider — they just rarely trip.
#
# The model / endpoint / limits (never the KEY) can also be changed at
# runtime by a superadmin via PATCH /api/admin/llm (persisted, health-checked,
# auto-rollback on failure) and probed via POST /api/admin/llm/test.

# --- CORS ----------------------------------------------------------------
# Comma-separated list of allowed origins. "*" for all (dev only).
ALLOWED_ORIGINS=*

# --- Database (PostgreSQL, MANDATORY) -----------------------------------
# The app refuses to start without this. The test suite overrides it with
# a throwaway SQLite database.
DATABASE_URL=postgresql://cv:cv@localhost:5432/cv_generator
# Kill a single SQL statement after this many ms (PostgreSQL only; 0 = off).
DB_STATEMENT_TIMEOUT_MS=15000

# --- JWT authentication (MANDATORY) -----------------------------------
# A long random string. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Superadmin -------------------------------------------------------
# CSV of e-mails promoted to superadmin on startup (existing accounts only;
# never auto-demotes). The only way to mint the first admin. Superadmins
# reach /api/admin/* — user management, ATS boards, provider & usage stats.
SUPERADMIN_EMAILS=

# --- Password reset (verification-code flow) --------------------------
PASSWORD_RESET_CODE_EXPIRE_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
# When true, POST /api/auth/forgot-password returns the code in its body.
# Local development / tests ONLY.
PASSWORD_RESET_DEV_MODE=false

# --- Account reactivation (deactivated-account recovery) -------------
# 8-digit one-time key, SHA-256 at rest, single-use, attempt-limited.
REACTIVATION_CODE_EXPIRE_MINUTES=30
REACTIVATION_MAX_ATTEMPTS=5
# When true, POST /api/auth/request-reactivation returns the key in its body.
# Local development / tests ONLY.
REACTIVATION_DEV_MODE=false

# --- E-mail delivery: Resend API -> SMTP -> dev-mode (log only) ------
# Leave everything blank to run in dev-mode (the reset code is only logged).
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@cv-generator.local

# --- MinIO object storage --------------------------------------------
# Every generated PDF is stored here; nothing is written to local disk.
# Unset MINIO_ENDPOINT to disable storage (generation routes then 503).
MINIO_ENDPOINT=localhost:9000
# The host a BROWSER downloads from. Presigned URLs are signed against this,
# not MINIO_ENDPOINT — inside Docker MINIO_ENDPOINT is "minio:9000" which a
# browser cannot resolve. In prod: your public object-store domain (https).
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_SECURE=false
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cv-files
MINIO_SECURE=false
MINIO_URL_EXPIRE_SECONDS=3600

# --- Application cache -----------------------------------------------
# Sits above the gemini_client prompt cache. In-memory when REDIS_URL is blank.
REDIS_URL=
CACHE_TTL=3600
# Bump to invalidate every cached entry at once.
CACHE_VERSION=1

# --- Uploads --------------------------------------------------------
MAX_UPLOAD_SIZE=10485760

# --- Job & internship search (multi-provider aggregation) -----------
# Comma-separated provider ids. Every provider degrades to "unavailable"
# cleanly; the reliable JSON/RSS ones keep search working when LinkedIn /
# Indeed are rate-limited. Adzuna self-disables without credentials.
JOBS_ENABLED_PROVIDERS=linkedin,indeed,arbeitnow,weworkremotely,hackernews,remotive,jobicy,remoteok,himalayas,adzuna

# Optional — Adzuna free tier (https://developer.adzuna.com/). Leave blank
# to disable the Adzuna provider; the rest of the system is unaffected.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Search cache + freshness windows
JOB_SEARCH_CACHE_TTL=900          # seconds a /api/jobs/search response is cached
JOB_FRESH_TTL_HOURS=24            # verified within this -> "fresh"
JOB_STALE_TTL_DAYS=14             # older & unverifiable -> "expired"
JOB_DEFAULT_EXPIRY_DAYS=30        # assumed lifetime when a source gives no end date
JOB_SEARCH_MAX_RESULTS=60         # hard cap on the aggregated result set
JOB_DEDUP_TITLE_RATIO=0.90        # title similarity (same company) to merge two offers

# Per-provider HTTP behaviour (responsible scraping — no anti-bot evasion)
JOB_PROVIDER_TIMEOUT=10.0
JOB_PROVIDER_MAX_PAGES=3
JOB_PROVIDER_MAX_RESULTS=50
# Provider fan-out: all providers run concurrently in a thread pool bounded by
# ONE wall-clock deadline, so a hung provider costs the deadline once (not once
# per hung provider) and a fast provider is never blocked behind a slow one.
JOB_SEARCH_GLOBAL_CONCURRENCY=32  # shared worker pool — caps provider threads across ALL searches
JOB_SEARCH_MAX_CONCURRENCY=20     # concurrent provider calls within one search
JOB_SEARCH_DEADLINE=45.0          # seconds for the whole fan-out

# --- Dashboard cache (v2.8) ------------------------------------------------
# GET /api/dashboard and GET /api/admin/dashboard share this one TTL, through
# services/cache_service.py (Redis when REDIS_URL is set, else in-memory).
# Best-effort either way — a broken cache backend never breaks a dashboard.
DASHBOARD_CACHE_TTL=60

# --- Conversational memory (v2.8) ------------------------------------------
# SQL (conversations / conversation_messages) is the source of truth; Redis
# only ever caches the most recent N messages of one conversation.
CONVERSATION_HISTORY_LIMIT=20          # messages sent to the LLM as context
CONVERSATION_HISTORY_CACHE_TTL=60      # seconds the recent-history cache lives

# --- Agent-orchestrated jobs (Phase 6) ----------------------------------
# The conversation agent runs JobSearchService / JobApplicationService directly.
AGENT_JOB_SELECTION_LIMIT=10           # top offers the agent keeps per search
AGENT_PENDING_ACTION_TTL_MIN=30        # a frozen "apply" proposal expires after this

# --- Profiling (v2.9 Phase 1) ---------------------------------------------
# Lightweight per-request latency + per-LLM-call measurement (durations,
# token counts, model names, flags only — never prompt/response/document
# content). One [PROFILE] log line per pipeline run; last-N profiles readable
# at GET /api/admin/profiling/recent (superadmin).
PROFILING_ENABLED=true
PROFILING_RING_SIZE=200

# --- Usage analytics ------------------------------------------------------
# Privacy-safe event log (counters + ids only, never content) powering the
# superadmin usage stats. Rows older than the retention window are pruned on
# startup.
USAGE_EVENTS_ENABLED=true
USAGE_EVENT_RETENTION_DAYS=400
JOB_PROVIDER_REQUEST_DELAY=1.0    # min seconds between requests to one host
JOB_PROVIDER_USER_AGENT=CVGeneratorJobBot/1.0 (+https://github.com/cv-generator; contact: admin@cv-generator.local)
JOB_HTTP_MAX_BYTES=3000000
JOB_HTTP_MAX_REDIRECTS=3

# Circuit breaker — a provider that keeps failing is skipped for a while
JOB_CIRCUIT_FAIL_THRESHOLD=3
JOB_CIRCUIT_COOLDOWN_SECONDS=600

# --- LinkedIn (public provider only — NO login/credentials) --------
# How deep the public guest search paginates.
LINKEDIN_MAX_PAGES=5

# --- ATS job boards (public JSON APIs, no key) --------------------
# Effective list per provider = bundled data/ats_boards/<x>.txt  +  <X>_BOARDS_FILE
#   +  <X>_BOARDS (CSV), de-duplicated (case-insensitive) and capped.
# All these vars are OPERATOR ADDITIONS on top of the shipped lists.
# A board that 404s / is blocked is silently skipped, never fatal.
ATS_USE_BUNDLED_BOARDS=true      # false -> ignore the shipped data/ats_boards/*.txt
ATS_MAX_BOARDS=60                # per provider per search — bounds the fan-out
ATS_BOARD_OVERLAY_TTL=60         # seconds the superadmin DB board overlay is cached
                                # (boards managed at POST/PATCH/DELETE /api/admin/ats-boards,
                                #  a pure ADDITION on top of the files + *_BOARDS env vars)

GREENHOUSE_BOARDS=              # extra slugs, e.g. mycompany,another-co
GREENHOUSE_BOARDS_FILE=        # optional: path to your own one-slug-per-line file
LEVER_BOARDS=
LEVER_BOARDS_FILE=
ASHBY_BOARDS=
ASHBY_BOARDS_FILE=
SMARTRECRUITERS_BOARDS=         # slugs, CASE-SENSITIVE (e.g. Visa1,BoschGroup)
SMARTRECRUITERS_BOARDS_FILE=
RIPPLING_BOARDS=
RIPPLING_BOARDS_FILE=
# Tenant-specific ATS — no bundled list, the provider self-disables until configured.
WORKDAY_TENANTS=                # full board URLs: https://acme.wd1.myworkdayjobs.com/AcmeCareers
WORKDAY_TENANTS_FILE=
ORACLE_HCM_SITES=              # full CandidateExperience URLs (*.oraclecloud.com)
ORACLE_HCM_SITES_FILE=
TALENTBREW_BOARDS=             # full ".../search-jobs/results?..." URLs
TALENTBREW_BOARDS_FILE=
PHENOM_BOARDS=                 # JSON: [{"company":"..","endpoint":"https://../widgets","payload":{}}]
PHENOM_BOARDS_FILE=           # optional: a file containing that JSON array
# Bounded per-job description enrichment for ATS whose board list omits it.
ATS_ENRICH_DESCRIPTIONS=true
ATS_ENRICH_MAX=20
# Response-size cap for the (larger) ATS board-list fetch. The strict 3 MB
# JOB_HTTP_MAX_BYTES still applies to every other request.
ATS_HTTP_MAX_BYTES=12000000

# --- Browser automation (BrowserSessionManager) -------------------
# Headless Chromium for the `career_pages` job provider. OFF by default.
# It renders PUBLIC pages only — no login, no credentials, never LinkedIn.
BROWSER_ENABLED=false
BROWSER_HEADLESS=true
BROWSER_BINARY=              # set in the Docker image to /usr/bin/chromium
BROWSER_DRIVER_PATH=         # set in the Docker image to /usr/bin/chromedriver
BROWSER_USER_DATA_DIR=/tmp/cv-generator-browser
BROWSER_PAGE_LOAD_TIMEOUT=30
BROWSER_SCRIPT_TIMEOUT=30
BROWSER_IMPLICIT_WAIT=0
BROWSER_MAX_PAGES_PER_SESSION=40
BROWSER_IDLE_SHUTDOWN_SECONDS=300
# Public company career-page URLs to render (CSV). Empty -> career_pages disabled.
CAREER_PAGE_URLS=
